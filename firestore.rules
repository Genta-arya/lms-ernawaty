rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isGuru() {
      return signedIn() && (
        exists(/databases/$(database)/documents/guru/$(request.auth.uid)) ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isMurid() {
      return isGoogle() &&
        exists(/databases/$(database)/documents/akunMurid/$(request.auth.uid));
    }

    function akun() {
      return get(/databases/$(database)/documents/akunMurid/$(request.auth.uid)).data;
    }

    match /guru/{uid} {
      // Siswa dan semua pengguna login boleh membaca profil guru (nama, mapel, dsb)
      allow read: if signedIn();
      // Guru boleh menyimpan atau memperbarui profilnya sendiri
      allow write: if isGuru();
    }

    match /sekolah/{id} {
      allow read: if true;
      allow write: if isGuru();
    }

    match /kelas/{id} {
      // Siswa yang sedang aktivasi dapat membaca daftar kelas untuk memilih kelas
      allow read: if signedIn();
      allow write: if isGuru();
    }

    match /murid/{nisn} {
      allow read, write: if isGuru();
      // Siswa teraktivasi dapat membaca data murid (untuk melihat teman sekelas di ruang kelas)
      allow read: if isMurid();
      // Siswa boleh memperbarui nama profilnya sendiri
      allow update: if isMurid() && akun().nisn == nisn;
      // pencarian data sendiri berdasarkan email (untuk aktivasi otomatis)
      allow get, list: if isGoogle() &&
        request.auth.token.email_verified == true &&
        resource.data.email == request.auth.token.email;
    }

    match /akunMurid/{uid} {
      // Izinkan pengguna terautentikasi membaca/memeriksa kepemilikan akun & validasi NISN unik
      allow read: if signedIn();
      allow create: if isGuru() ||
        (isGoogle() && request.auth.uid == uid &&
         request.auth.token.email_verified == true &&
         get(/databases/$(database)/documents/murid/$(request.resource.data.nisn))
           .data.email == request.auth.token.email);
      allow update: if isGuru() || (signedIn() && request.auth.uid == uid);
      allow delete: if isGuru();
    }

    match /klaim/{uid} {
      allow create: if isGoogle() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['nisn','nama','email','kelasId','status','catatan','createdAt']) &&
        request.resource.data.status == 'menunggu' &&
        request.resource.data.nisn.matches('^[0-9]{10}$');
      // Izinkan pengguna terautentikasi membaca status klaim miliknya dan pengecekan duplikasi NISN
      allow read: if signedIn();
      // Murid boleh update permohonan mereka jika sebelumnya ditolak
      allow update: if isGuru() || 
        (isGoogle() && request.auth.uid == uid && 
         resource.data.status == 'ditolak' && 
         request.resource.data.status == 'menunggu' &&
         request.resource.data.nisn.matches('^[0-9]{10}$'));
      allow delete: if isGuru() || (signedIn() && request.auth.uid == uid);
    }

    match /materi/{id} {
      allow read: if resource.data.status == 'terbit' || isGuru();
      allow write: if isGuru();
    }

    match /kuis/{id} {
      allow read: if isGuru() || (isMurid() && resource.data.status == 'terbit');
      allow write: if isGuru();
    }

    match /percobaan/{id} {
      allow create: if isMurid() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nisn == akun().nisn &&
        request.resource.data.skor is number &&
        request.resource.data.skor >= 0 && request.resource.data.skor <= 100;
      // Siswa teraktivasi dapat membaca skor kuis (untuk leaderboard dan peringkat kelas)
      allow read: if isGuru() || isMurid();
      allow update, delete: if isGuru();
    }

    match /progres/{id} {
      allow read: if isGuru() || (isMurid() && resource.data.uid == request.auth.uid);
      allow create, update: if isMurid() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nisn == akun().nisn &&
        id == request.auth.uid + '_' + request.resource.data.materiId;
      allow delete: if isGuru();
    }

    match /karya/{id} {
      // Semua pengguna (termasuk publik) dapat membaca karya mading
      allow read: if true;
      // Pengguna yang login (siswa teraktivasi atau guru) dapat memposting karya
      allow create: if signedIn();
      // Memberi like & komentar dapat dilakukan oleh pengguna login
      allow update: if signedIn();
      // Hanya pembuat karya atau guru yang boleh menghapus
      allow delete: if isGuru() || (signedIn() && resource.data.penulisUid == request.auth.uid);
    }

    match /pengumuman/{id} {
      // Semua siswa dan guru dapat membaca pengumuman
      allow read: if true;
      // Hanya guru yang boleh membuat, mengedit, dan menghapus pengumuman
      allow write: if isGuru();
    }

    match /tugas/{id} {
      // Siswa dan guru dapat membaca tugas
      allow read: if isGuru() || (signedIn() && resource.data.status == 'terbit');
      // Hanya guru yang boleh membuat, mengedit, dan menghapus tugas
      allow write: if isGuru();
    }

    match /pengumpulanTugas/{id} {
      // Guru dapat membaca semua, siswa dapat membaca pengumpulan (termasuk nilai teman sekelas)
      allow read: if isGuru() || isMurid();
      // Siswa dapat mengumpulkan tugasnya sendiri, guru dapat menilai
      allow create: if isGuru() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isGuru() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isGuru();
    }

    match /chatKelas/{id} {
      // Siswa teraktivasi dan guru dapat membaca pesan obrolan kelas
      allow read: if isGuru() || isMurid();
      // Siswa teraktivasi dan guru dapat mengirim pesan
      allow create: if (isMurid() || isGuru()) &&
        request.resource.data.pesan is string &&
        request.resource.data.pesan.size() > 0 &&
        request.resource.data.pesan.size() <= 1000;
      allow update, delete: if isGuru() || (signedIn() && resource.data.pengirimUid == request.auth.uid);
    }

    match /chatPribadi/{id} {
      // Siswa teraktivasi dan guru dapat membaca pesan jika termasuk partisipan obrolan
      allow read: if isGuru() || isMurid();
      // Siswa teraktivasi dan guru dapat mengirim pesan pribadi
      allow create: if (isMurid() || isGuru()) &&
        request.resource.data.pesan is string &&
        request.resource.data.pesan.size() > 0 &&
        request.resource.data.pesan.size() <= 1000;
      // Pengirim boleh mengupdate/menghapus pesan, atau penerima boleh mengupdate status read (dibaca: true)
      allow update: if signedIn();
      allow delete: if isGuru() || (signedIn() && resource.data.pengirimId == request.auth.uid);
    }

    match /typingKelas/{id} {
      allow read, write: if signedIn();
    }

    match /typingPribadi/{id} {
      allow read, write: if signedIn();
    }

    match /userPresence/{id} {
      allow read, write: if signedIn();
    }




    match /meetControls/{id} {
      allow read, write: if signedIn();
    }

    match /sesiMeet/{id} {
      // Semua pengguna login dapat membaca status sesi meet
      allow read: if signedIn();
      // Hanya guru yang dapat membuat, mengupdate status, dan menghapus sesi meet
      allow write: if isGuru();
    }

    match /forumDiskusi/{id} {
      // Siswa teraktivasi dan guru dapat membaca diskusi
      allow read: if signedIn();
      // Siswa dan guru dapat memposting pertanyaan/tanggapan
      allow create: if (isMurid() || isGuru()) &&
        request.resource.data.isi is string &&
        request.resource.data.isi.size() > 0 &&
        request.resource.data.isi.size() <= 2000;
      // Guru atau pengirim sendiri dapat mengupdate / menghapus postingan
      allow update, delete: if isGuru() || (signedIn() && resource.data.pengirimId == request.auth.uid);
    }

    match /fcmTokens/{id} {
      allow read, write: if signedIn();
    }
  }
}